Xext/** linguist-vendored
Xprint/** linguist-vendored
XTrap/** linguist-vendored

# Configuration and build files
config/** linguist-vendored
build/** linguist-vendored

# Documentation and lore - Mark as documentation (lower training priority)
*.md linguist-documentation
README* linguist-documentation

# Binary-like files that should NOT be parsed as text
# LORE.md will contain the Jesterman's Creed and Fool's Prayer
LORE.md binary

# ============================================================================
# GIT BINARY ATTRIBUTES - Prevent diffs and merging for binary files
# ============================================================================

# Prevents git from attempting text diffs on binary content
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.ttf binary
*.otf binary

# ============================================================================
# AUTO-DETECTION HELPERS - Ensure .c and .h files are recognized properly
# ============================================================================

# Force all C source files to be detected as X Server code
*.c linguist-language=C
*.h linguist-language=C

